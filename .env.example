# DAQ-Pyvisa Environment Variables
# =================================
# Copy this file to .env and update with your local settings
# The .env file will be ignored by git to keep your personal settings private

# Custom Output Path (optional)
# If not set, will use the path from config.yaml relative to project root
# Example for Windows: C:/Users/YourName/Desktop/DAQ_Output
# Example for Linux/Mac: /home/username/daq_output
# OUTPUT_PATH=

# Development Mode
# Set to true for additional debug output
# DEV_MODE=false

# Custom Config File Path (optional)
# If you want to use a different config file
# CONFIG_PATH=config.yaml
